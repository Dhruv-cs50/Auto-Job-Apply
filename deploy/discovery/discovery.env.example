# Non-secret settings only. Pin the deployed image by immutable digest.
DISCOVERY_IMAGE=registry.example/auto-job-discovery@sha256:replace-with-real-digest
SCHEDULER_TRIGGER_URL=https://private-dashboard.example/internal/discovery/runs
SCHEDULER_ID=hourly-discovery
SCHEDULER_SLOT_MINUTES=60
SCHEDULER_TIMEOUT_MS=30000
SCHEDULER_MAX_ATTEMPTS=3
